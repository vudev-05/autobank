# ==============================================
# AUTOBANK PRO - .gitignore
# ==============================================

# ── Node.js / npm ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# ── Build outputs ──
dist/
build/
.output/
.nuxt/

# ── Environment Variables (KHÔNG COMMIT FILE NÀY!) ──
.env
.env.local
.env.*.local
apps/api/.env

# ── OS / Document files ──
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini
*.pdf

# ── Editor / IDE ──
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── NestJS / API ──
apps/api/node_modules/
apps/api/dist/
apps/api/.DS_Store

# ── Vite / Web ──
apps/web/node_modules/
apps/web/dist/
apps/web/.vite/

# ── Flutter / Dart ──
.dart_tool/
.packages
.pub-cache/
.pub/
apps/mobile/build/
apps/mobile/.dart_tool/
apps/mobile/.idea/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/android/app/google-services.json
apps/mobile/ios/Pods/
apps/mobile/ios/.symlinks/
apps/mobile/ios/Flutter/App.framework
apps/mobile/ios/Flutter/Flutter.framework
apps/mobile/ios/Flutter/Generated.xcconfig
apps/mobile/ios/Runner/GeneratedPluginRegistrant.*
*.g.dart

# ── Logs ──
logs/
*.log
npm-debug.log*

# ── Prisma ──
apps/api/prisma/*.db
apps/api/prisma/*.db-journal

# ── Android Builds / APK ──
*.apk
*.aab
release_builds/
check_user_db*.cjs

# ── Deployment & Inspection Scripts with server credentials ──
scripts/
start_all.bat
install_apk_to_phone.bat

