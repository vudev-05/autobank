datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Merchant {
  id           String           @id @default(uuid())
  name         String
  slug         String           @unique
  secretKey    String           @default(uuid())
  webhookUrl   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  members      MerchantMember[]
  bankAccounts BankAccount[]
  orders       Order[]
  transactions Transaction[]

  @@map("merchants")
}

model User {
  id          String           @id @default(uuid())
  email       String           @unique
  name        String?
  firebaseUid String?          @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  memberships MerchantMember[]

  @@map("users")
}

model MerchantMember {
  id         String   @id @default(uuid())
  merchantId String
  userId     String
  role       String   @default("STAFF") // OWNER, STAFF, ACCOUNTANT
  createdAt  DateTime @default(now())

  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([merchantId, userId])
  @@map("merchant_members")
}

model BankAccount {
  id            String        @id @default(uuid())
  merchantId    String
  bankCode      String        // MBBANK, VIETCOMBANK,...
  accountNumber String
  accountName   String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())

  merchant      Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@unique([merchantId, bankCode, accountNumber])
  @@map("bank_accounts")
}

model Transaction {
  id              String       @id @default(uuid())
  merchantId      String?
  bankAccountId   String?
  userEmail       String?
  bankCode        String
  accountNumber   String
  amount          Decimal      @db.Decimal(15, 2)
  type            String       @default("credit") // credit, debit
  content         String       @db.Text
  orderCode       String?
  transactionTime DateTime
  rawContent      String       @db.Text
  fingerprint     String       @unique
  status          String       @default("UNMATCHED") // UNMATCHED, MATCHED
  matchedOrderId  String?
  category        String?
  note            String?      @db.Text
  createdAt       DateTime     @default(now())

  merchant        Merchant?    @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  bankAccount     BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  matchedOrder    Order?       @relation(fields: [matchedOrderId], references: [id], onDelete: SetNull)

  @@index([transactionTime])
  @@index([status])
  @@index([orderCode])
  @@index([userEmail])
  @@map("transactions")
}

model Order {
  id            String        @id @default(uuid())
  merchantId    String
  orderCode     String        @unique // vd: DH1058
  totalAmount   Decimal       @db.Decimal(15, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(15, 2)
  status        String        @default("PENDING") // PENDING, PARTIALLY_PAID, PAID, OVERPAID, CANCELLED
  description   String?
  customerName  String?
  customerPhone String?
  qrCodeUrl     String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  merchant      Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@index([merchantId, status])
  @@map("orders")
}

model WebhookLog {
  id           String   @id @default(uuid())
  merchantId   String?
  orderCode    String?
  event        String   // payment.success, payment.partially_paid, thueapi.webhook
  payload      String   @db.Text
  responseCode Int?
  status       String   @default("PENDING") // SUCCESS, FAILED, RETRYING, BLOCKED
  retryCount   Int      @default(0)
  createdAt    DateTime @default(now())

  @@map("webhook_logs")
}

model SystemConfig {
  id             String   @id @default("default")
  brandName      String   @default("Đọc thông báo nhận tiền")
  brandSlogan    String   @default("Tiền vừa sang ~ máy báo vang")
  chplayLink     String   @db.Text
  youtubeLink    String   @db.Text
  hotline        String   @default("0869226687")
  email          String   @default("tranquocvu3011@gmail.com")
  facebook       String?  @db.Text
  tiktok         String?  @db.Text
  bankCode       String   @default("MB")
  bankAcc        String   @default("0869226687")
  bankName       String   @default("TRẦN QUỐC VŨ")
  priceTrial     String   @default("0đ (3 ngày)")
  price1m        Int      @default(38000)
  price3m        Int      @default(99000)
  price6m        Int      @default(179000)
  price9m        Int      @default(249000)
  price1y        Int      @default(299000)
  priceLifetime  Int      @default(499000)
  bonusMonths1y  Int      @default(2)
  thueApiEnabled Boolean  @default(false)
  thueApiKey     String?  @db.Text
  thueApiSecret  String?  @db.Text
  thueApiBankAcc String?  @default("0869226687")
  thueApiBankCode String? @default("MB")
  marketingBanner String? @db.Text
  maintenance    Boolean  @default(false)
  maintenanceMsg String?  @db.Text
  googlePayMaintenance Boolean @default(false)
  googlePayMaintenanceMsg String? @db.Text
  latestVersion  String   @default("1.2.0")
  minVersion     String   @default("1.0.0")
  serverDomain   String?  @db.Text
  webDomain      String?  @db.Text
  apiPort        Int?     @default(3000)
  packagesJson   String?  @db.Text
  masterApiKey    String?  @db.Text
  fcmServerKey    String?  @db.Text
  webhookEndpoint String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("system_configs")
}

model ApiKey {
  id        String   @id @default(uuid())
  name      String
  key       String   @unique
  role      String   @default("FULL")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("api_keys")
}

model DiscountCoupon {
  id              String   @id @default(uuid())
  code            String   @unique
  description     String
  discountPercent Int      @default(0)
  discountAmount  Int      @default(0)
  minPrice        Int      @default(0)
  targetAudience  String   @default("ALL") // ALL, NEW_3DAYS, MANUAL
  autoApply       Boolean  @default(true)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("discount_coupons")
}

model BankApp {
  id        String   @id
  name      String
  app       String
  code      String
  pkg       String
  category  String   @default("commercial")
  logo      String   @db.Text
  guide     String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bank_apps")
}

model AppDeviceUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  device       String
  version      String   @default("1.2.0")
  packagePlan  String   @default("1 Năm")
  hasUsedTrial Boolean  @default(false)
  expiresAt    DateTime
  status       String   @default("ACTIVE")
  deviceId     String?
  phone        String?
  shopName          String?
  voiceSettingsJson String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("app_device_users")
}

model PushBroadcast {
  id        String   @id @default(uuid())
  type      String   @default("system_update")
  title     String
  body      String   @db.Text
  action    String   @default("open_app")
  createdAt DateTime @default(now())

  @@map("push_broadcasts")
}

model AdminAccount {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   @default("SUPER_ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_accounts")
}

