# ==============================================================================
# AUTOBANK PRO - PRODUCTION CONFIGURATION ENVIRONMENT VARIABLES
# ==============================================================================

# 1. CẤU HÌNH MÁY CHỦ & CƠ SỞ DỮ LIỆU MYSQL
PORT=3000
DATABASE_URL="mysql://username:password@localhost:3306/autobank?connection_limit=20"
APP_URL="https://your-domain.com"

# 2. KHÓA BẢO MẬT HỆ THỐNG & PHIÊN ĐĂNG NHẬP (Bắt buộc thay đổi bằng chuỗi ngẫu nhiên dài)
JWT_SECRET="generate_a_very_secure_random_string_here_min_32_chars"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=autobank@2026

# 3. GOOGLE OAUTH 2.0 (Xác thực đăng nhập tài khoản Google trên Android & Web)
# Hướng dẫn chi tiết xem tại file: GOOGLE_OAUTH_SETUP.md
# Lấy từ Google Cloud Console > APIs & Services > Credentials:
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# 4. TÍCH HỢP NHÀ CUNG CẤP TỰ ĐỘNG THUEAPI.PRO (Kích hoạt bản quyền qua VietQR)
# Đăng ký tài khoản tại: https://thueapi.pro/
# Lấy API Key từ Dashboard ThueApi.Pro và cấu hình Webhook URL
THUEAPI_ENABLED=true
THUEAPI_API_KEY=""
THUEAPI_BANK_ACC="3011200588888"
THUEAPI_BANK_CODE="MB"

# 5. FIREBASE CLOUD MESSAGING (FCM) - Tùy chọn Push Notification
FCM_SERVER_KEY=""

# 6. SMTP EMAIL NOTIFICATION - Gửi thông báo đơn hàng và bản quyền qua Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notification@your-domain.com"
SMTP_PASS=""
SMTP_FROM="AutoBank PRO <notification@your-domain.com>"
