<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Clean URL for Web Live (/live -> live.html)
    RewriteRule ^live/?$ live.html [L,QSA]

    # 2. Clean URLs for Admin Panel
    RewriteRule ^admin/?$ admin/index.html [L,QSA]
    RewriteRule ^admin/login/?$ admin/login.html [L,QSA]
    RewriteRule ^admin/config/?$ admin/config.html [L,QSA]
    RewriteRule ^admin/banks/?$ admin/banks.html [L,QSA]
    RewriteRule ^admin/users/?$ admin/users.html [L,QSA]
    RewriteRule ^admin/notifications/?$ admin/notifications.html [L,QSA]
    RewriteRule ^admin/coupons/?$ admin/coupons.html [L,QSA]
    RewriteRule ^admin/orders/?$ admin/orders.html [L,QSA]
    RewriteRule ^admin/keys/?$ admin/keys.html [L,QSA]
    RewriteRule ^admin/payment-autobank/?$ admin/payment-autobank.html [L,QSA]

    # 3. Serve existing files and directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. Default fallback to index.html
    RewriteRule ^ index.html [L,QSA]
</IfModule>

# Enable CORS for fonts and assets
<IfModule mod_headers.c>
    <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2|font.css|css|js)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>
