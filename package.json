{
  "name": "autobank-platform",
  "version": "1.0.0",
  "description": "AutoBank - A payment management and reconciliation platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=apps/api",
    "build:api": "npm run build --workspace=apps/api",
    "test:api": "npm run test --workspace=apps/api",
    "dev:web": "npm run dev --workspace=@autobank/web",
    "build:web": "npm run build --workspace=@autobank/web",
    "dev:app": "cd apps/mobile && flutter run -d web-server --web-port=8080 --web-hostname=0.0.0.0"
  },
  "devDependencies": {
    "ssh2": "^1.17.0"
  }
}
